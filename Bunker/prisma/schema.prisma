// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lobby {
  id          String     @id @default(uuid())
  join_code   String     @unique
  lobby_name   String
  apocalypse  String
  host_id     String?    @unique
  max_players Int        @default(10)
  status      LobbyStatus @default(LOBBY)
  created_at  DateTime   @default(now())
  updated_at  DateTime   @updatedAt

  apocalypseRel Apocalypse @relation(fields: [apocalypse], references: [name])
  players       Player[]   @relation("LobbyPlayers")
  host          Player?    @relation("LobbyHost", fields: [host_id], references: [id], onDelete: SetNull)

  @@index([status])
}

model Player {
  id         String       @id @default(uuid())
  secret_key String       @unique
  name       String
  status     PlayerStatus @default(JOINED)
  lobby_id    String

  lobby        Lobby   @relation("LobbyPlayers", fields: [lobby_id], references: [id], onDelete: Cascade)
  hostingLobby Lobby?  @relation("LobbyHost")
  decks       Deck[]
}

model Apocalypse {
  name  String @id
  lobbys Lobby[]
}

model Deck {
  player_id  String
  card_id    String
  status     DeckStatus @default(HIDDEN)
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt

  player Player @relation(fields: [player_id], references: [id], onDelete: Cascade)
  card   Card   @relation(fields: [card_id], references: [card_id], onDelete: Cascade)

  @@id([player_id, card_id])
  @@index([card_id])
  @@index([status])
}

model Card {
  card_id     String  @id
  category    String
  description String?
  imageUrl    String?

  categoryRel Category @relation(fields: [category], references: [name])
  decks       Deck[]

  @@index([category])
}

model Category {
  name  String @id
  cards Card[]
}

enum PlayerStatus {
  JOINED
  READY
  PLAYING
  DISCONNECTED
  LEFT
  KICKED
}

enum LobbyStatus {
  LOBBY
  STARTING
  IN_PROGRESS
  FINISHED
  CLOSED
}

enum DeckStatus {
  HIDDEN
  REVEALED
  DISCARDED
}
